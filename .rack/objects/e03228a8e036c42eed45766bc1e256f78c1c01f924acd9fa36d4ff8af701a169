local M = {}

function M.open(proj)
  local cli     = require('rack.cli')
  local parse   = require('rack.parse')
  local picker  = require('rack.ui.picker')
  local actions = require('rack.actions')

  local args = { 'log' }
  if proj then table.insert(args, proj) end

  cli.run(args, function(out, e, code)
    if code ~= 0 then
      vim.notify('rack log: ' .. (e ~= '' and e or out), vim.log.levels.ERROR, { title = 'Rack' })
      return
    end

    local plates = parse.log(out)
    if #plates == 0 then
      vim.notify('No plates yet', vim.log.levels.INFO, { title = 'Rack' })
      return
    end

    picker.open({
      title  = 'Plate Log',
      items  = plates,
      format = function(p)
        local head = p.is_head and '  HEAD' or ''
        return ('%-14s  %-8s  %s%s'):format(p.id, p.flag, p.name, head)
      end,

      preview = function(item, bufnr)
        local lines = {
          'ID:     ' .. item.id,
          'Flag:   ' .. item.flag,
          'Name:   ' .. item.name,
          'Files:  ' .. tostring(item.file_count),
          item.is_head and '        <- HEAD' or '',
          '',
        }
        vim.api.nvim_buf_set_lines(bufnr, 0, -1, false, lines)

        -- For HEAD plate, async-load the file list
        if item.is_head then
          local fargs = { 'files' }
          if proj then table.insert(fargs, proj) end
          cli.run(fargs, function(fout, _, fcode)
            if fcode ~= 0 then return end
            local files = parse.files(fout)
            local new_lines = vim.list_extend(vim.list_extend({}, lines), {})
            -- replace "Files: N" line with actual list
            for i, l in ipairs(new_lines) do
              if l:match('^Files:') then
                new_lines[i] = ('Files:  %d'):format(#files)
                break
              end
            end
            for _, f in ipairs(files) do table.insert(new_lines, '  ' .. f) end
            vim.schedule(function()
              if not vim.api.nvim_buf_is_valid(bufnr) then return end
              vim.api.nvim_set_option_value('modifiable', true,  { buf = bufnr })
              vim.api.nvim_buf_set_lines(bufnr, 0, -1, false, new_lines)
              vim.api.nvim_set_option_value('modifiable', false, { buf = bufnr })
            end)
          end)
        end
      end,

      item_hl = function(p)
        if p.flag == 'Hotfix' then return 'RackFlagHotfix' end
        if p.flag == 'Knot'   then return 'RackFlagKnot'   end
        if p.name ~= ''       then return 'RackNamed'      end
      end,

      on_select = function(item)
        actions.restore(item.id)
      end,

      mappings = {
        -- <C-r>: restore without confirm dialog
        ['<C-r>'] = function(item, close_fn)
          close_fn()
          cli.run({ 'restore', item.id }, function(out, e, code)
            if code ~= 0 then
              vim.notify('Restore failed: ' .. (e ~= '' and e or out), vim.log.levels.ERROR, { title = 'Rack' })
              return
            end
            vim.notify('Restored: ' .. item.id:sub(1, 12), vim.log.levels.INFO, { title = 'Rack' })
            vim.cmd('checktime')
          end)
        end,
      },
    })
  end)
end

return M
